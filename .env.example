# MacGyver Classroom environment example
# Copy to `.env` for local API/Next.js work. Do not commit real secrets.

# Shared local URLs
PORT=4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_ADMIN_URL=http://127.0.0.1:3001
NEXT_PUBLIC_LANDING_URL=http://127.0.0.1:3002
# Comma-separated API CORS origins. Leave empty for local Flutter/web dev
# origins like http://localhost:<port> and http://127.0.0.1:<port>.
CORS_ORIGINS=

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/macgyver_classroom

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_BUCKET_SCAN_IMAGES=scan-images

# Auth
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Vertex AI / Gemini vision scan
# Scan analysis always uses the configured Google Vertex/Gemini provider.
# Local dev must supply credentials; missing/invalid credentials make analyze fail
# instead of returning synthetic detected items.
# Keep GOOGLE_SERVICE_ACCOUNT_JSON as a single-line JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-google-project-id","private_key_id":"replace","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace\\n-----END PRIVATE KEY-----\\n","client_email":"vertex-ai@your-google-project-id.iam.gserviceaccount.com","client_id":"replace","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/vertex-ai%40your-google-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}
GOOGLE_VERTEX_PROJECT_ID=your-google-project-id
GOOGLE_VERTEX_LOCATION=global
GOOGLE_VERTEX_MODEL=gemini-2.5-flash

# Inventory scan payload limit for transient base64 image analysis.
SCAN_ANALYZE_JSON_BODY_LIMIT=16mb

# Flutter mobile does not read `.env` directly. Pass these via --dart-define:
# flutter run --dart-define=MCG_BACKEND=api --dart-define=MCG_API_PORT=3000 --dart-define=MCG_API_BASE_URL=http://127.0.0.1:3000
MCG_BACKEND=api
MCG_API_PORT=3000
MCG_API_BASE_URL=http://127.0.0.1:3000
